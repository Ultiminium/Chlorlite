#!/usr/bin/env bash
# cc — the Chlorlite build tool. Cargo-style: native by default, --target to cross-compile.
#
#   cc build <game.c|dir> [-o name]                 → native executable (this host)
#   cc build <game.c|dir> --target windows [-o name] → Windows .exe (cross-compile)
#   cc build <game.c|dir> --target linux   [-o name] → Linux ELF (explicit)
#   cc run   <game.c|dir>                            → build native + run it
#
# Native builds need nothing but the host toolchain + desktop libs. Cross-compiling
# to Windows needs mingw-w64 (auto-installed if missing). Produced binaries are
# standalone: the engine is statically linked, and only OS-standard libraries are
# dynamically referenced.
set -e

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENGINE="$SKILL_DIR/engine"

# ── parse args ────────────────────────────────────────────────────────────
CMD="${1:-}"; shift || true
GAME=""; OUT=""; TARGET="native"
# `cc dev` is shorthand: build headless-capable (OSMesa) + run to screenshot.
if [ "$CMD" = "dev" ]; then TARGET="dev"; fi
while [ $# -gt 0 ]; do
  case "$1" in
    --target) TARGET="$2"; shift 2;;
    --target=*) TARGET="${1#*=}"; shift;;
    -o) OUT="$2"; shift 2;;
    -o*) OUT="${1#-o}"; shift;;
    *) GAME="$1"; shift;;
  esac
done

# normalize target: host os when "native"
HOST_OS="$(uname -s)"
if [ "$TARGET" = "native" ]; then
  case "$HOST_OS" in Linux) TARGET=linux;; *) TARGET=linux;; esac
fi

if [ -z "$CMD" ] || { [ "$CMD" != "build" ] && [ "$CMD" != "run" ] && [ "$CMD" != "bundle" ] && [ "$CMD" != "dev" ]; }; then
  echo "usage: cc build|run|bundle|dev <game.c|dir> [--target windows|linux] [-o name]"
  echo "  build  — ship build (windowed, self-contained)"
  echo "  dev    — headless-capable build (OSMesa) for screenshots; how Claude sees output"
  echo "  run    — build native + run"
  echo "  bundle — zip exe + assets + README"
  exit 1
fi
[ -z "$GAME" ] && { echo "error: no game source given"; exit 1; }
[ -z "$OUT" ] && OUT="$(basename "${GAME%.*}")"

# collect sources
if   [ -f "$GAME" ]; then SOURCES="$GAME"
elif [ -d "$GAME" ]; then SOURCES=$(find "$GAME" -name '*.c' | tr '\n' ' ')
else echo "error: '$GAME' not found"; exit 1; fi

# ── entry-point resolution ─────────────────────────────────────────────────
# Two supported game styles:
#   (a) the game defines its own `int main(...)` — used as-is;
#   (b) the game exports the plugin trio cc_game_init/tick/shutdown and no main —
#       we synthesize a tiny bootstrap main that drives them through cc_run.
# This keeps both templates and hand-written mains building through one tool.
if ! grep -Eqs '^[[:alnum:]_[:space:]\*]*\bmain[[:space:]]*\(' $SOURCES; then
  if grep -qs '\bcc_game_init\b' $SOURCES; then
    BOOT="$(mktemp -d)/cc_bootstrap.c"
    cat > "$BOOT" << 'BOOTEOF'
/* Auto-generated by `cc`: bootstrap for cc_game_* plugin-style games.
   Wires the exported lifecycle callbacks to the engine's frame loop. */
#include "cc/claudecore.h"
void cc_game_init(CCEngine* eng);
void cc_game_tick(CCEngine* eng, double dt);
void cc_game_shutdown(CCEngine* eng);
static void cc__boot_frame(CCEngine* eng, double dt, void* ud) { (void)ud; cc_game_tick(eng, dt); }
int main(void) {
#ifdef CC_USE_OSMESA
    CCEngineConfig cfg = cc_sandbox_config();   /* headless dev build → screenshots */
#else
    CCEngineConfig cfg = cc_default_config();   /* ship build → window if present */
#endif
    cfg.on_frame = cc__boot_frame;
    cfg.target_fps = 60;
    CCEngine* eng = cc_init(&cfg);
    if (!eng) return 1;
    cc_game_init(eng);
    cc_run(eng);
    cc_game_shutdown(eng);
    cc_shutdown(eng);
    return 0;
}
BOOTEOF
    SOURCES="$SOURCES $BOOT"
    echo "  (no main found — using cc_game_* bootstrap)" >&2
  fi
fi

INC="-I$ENGINE/include -I$SKILL_DIR/qwerty/include"

# ── netkit (optional networking LIBRARY, built ON the engine, not part of it) ──
# netkit is a separate library that lives alongside CC: command channel, UDP
# transport, and client prediction — the parts of networking a GAME assembles, as
# opposed to the engine's own replication seam (cc/net.h, which stays in the
# engine because only the engine owns the ECS). A game opts in simply by including
# a <netkit/...> header; we detect that and add its include dir + sources. Games
# that don't touch netkit pay nothing for it.
NETKIT="$SKILL_DIR/netkit"
if [ -d "$NETKIT" ] && grep -Eqs '#[[:space:]]*include[[:space:]]*["<]netkit/' $SOURCES; then
  INC="$INC -I$NETKIT/include"
  SOURCES="$SOURCES $(find "$NETKIT/src" -name '*.c' | tr '\n' ' ')"
  echo "  (netkit networking library linked)" >&2
fi

# ── voxel (optional marching-cubes terrain/caves LIBRARY) ──
VOXEL="$SKILL_DIR/voxel"
if [ -d "$VOXEL" ] && grep -Eqs '#[[:space:]]*include[[:space:]]*["<]voxel/' $SOURCES; then
  INC="$INC -I$VOXEL/include -I$VOXEL/src"
  SOURCES="$SOURCES $(find "$VOXEL/src" -name '*.c' | tr '\n' ' ')"
  echo "  (voxel terrain/caves library linked)" >&2
fi

# ── engine object build (per target, cached) ──────────────────────────────
build_engine() {
  local cc="$1" tag="$2" extra="$3"
  local bdir="$ENGINE/.build-$tag"
  mkdir -p "$bdir"
  local ENGINE_SRCS="engine.c renderer.c ecs.c camera.c procgen.c scripting_c.c \
    physics.c scene_graph.c scene_render.c input_map.c steam.c audio.c cc_gl_loader.c \
    assets/ccmodel.c assets/ccscene.c save.c anim/anim.c debug.c debug_image.c player.c ai.c world.c editmesh.c actor.c gui.c interact.c dialogue.c particles.c tween.c trail.c move.c worldui.c prefab.c inputrec.c nineslice.c event.c coro.c director.c mic.c soundfield.c audiofx.c console.c savegame.c aa.c group.c pixshape.c jobs.c net.c combat.c timeline.c assetpack.c canonframe.c scripting_py.c"
  if [ ! -f "$bdir/libclaudecore.a" ]; then
    echo "  compiling engine ($tag)…" >&2
    local objs=""
    for s in $ENGINE_SRCS; do
      local o="$bdir/$(echo "$s" | tr / _).o"
      $cc -c -O2 -std=gnu17 $extra $INC "$ENGINE/src/$s" -o "$o" >&2
      objs="$objs $o"
    done
    # qwerty core (all targets) + POSIX backends (Linux only)
    local qsrcs="qwerty.c"
    if [ "$tag" != "windows" ]; then qsrcs="qwerty.c backend_x11.c backend_evdev.c"; fi
    local qobjs=""
    for qs in $qsrcs; do
      local qo="$bdir/qw_${qs%.c}.o"
      $cc -c -O2 -std=gnu17 $extra -I"$SKILL_DIR/qwerty/include" "$SKILL_DIR/qwerty/src/$qs" -o "$qo" >&2
      qobjs="$qobjs $qo"
    done
    "${cc%gcc}ar" rcs "$bdir/libclaudecore.a" $objs >&2
    "${cc%gcc}ar" rcs "$bdir/libqwerty.a" $qobjs >&2
  fi
  echo "$bdir"
}

case "$TARGET" in
  linux|dev)
    # Optional embedded-Python scripting: enable with CC_PY=1 (needs python3-dev).
    # When off, scripting_py.c compiles to an empty TU (guarded by the define) and
    # no python lib is linked, keeping the default build lean.
    PYFLAGS=""; PYLINK=""
    if [ "${CC_PY:-0}" = "1" ] && command -v python3-config &>/dev/null; then
      PYFLAGS="-DCC_SCRIPTING_PYTHON $(python3-config --includes)"
      PYLINK="$(python3-config --ldflags --embed 2>/dev/null || python3-config --ldflags)"
      echo "  (CC_PY=1: embedding Python — $(python3 --version 2>&1))" >&2
    fi
    if [ "$TARGET" = "dev" ]; then
      echo "╔═ cc dev → linux + OSMesa (headless screenshots) ══╗"
    else
      echo "╔═ cc build → linux (native) ═══════════════════════╗"
    fi
    if command -v apt-get &>/dev/null; then
      apt-get update -qq 2>/dev/null || true
      apt-get install -y -qq libglfw3-dev libgl-dev libx11-dev libosmesa6-dev libopenal-dev \
        libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
        libsndfile1-dev libzstd-dev 2>/dev/null | grep -v "^$\|already" || true
    fi
    GLFW_LINUX="$ENGINE/third_party/glfw-linux64"
    AUDIO_LINUX="$ENGINE/third_party/audio-linux64"
    if [ "$TARGET" = "dev" ]; then
      # DEV build: OSMesa + GLFW both compiled in. Renders headless (software) so
      # cc_screenshot always works with no display — this is how Claude SEES its
      # work. Falls back cleanly: GLFW window if a display exists, else OSMesa.
      BDIR=$(build_engine "gcc" "linux-dev${PYFLAGS:+-py}" "-DCC_USE_GLFW -DCC_USE_OSMESA -DCC_USE_AUDIO -I$ENGINE/third_party/openal-include $PYFLAGS")
      LINK="$GLFW_LINUX/lib/libglfw3.a $AUDIO_LINUX/lib/libopenal.a -lOSMesa"
      LINK="$LINK -lGL -lX11 -lXrandr -lXinerama -lXcursor -lXi -lm -lpthread -ldl -lrt -lstdc++"
      [ -f /usr/lib/x86_64-linux-gnu/libzstd.a ] && LINK="$LINK /usr/lib/x86_64-linux-gnu/libzstd.a" \
        || { [ -f /usr/lib/x86_64-linux-gnu/libzstd.so ] && LINK="$LINK -lzstd"; }
      gcc -O2 -std=gnu17 -DCC_USE_GLFW -DCC_USE_OSMESA -DCC_USE_AUDIO $PYFLAGS $INC -I"$GLFW_LINUX/include" $SOURCES \
        "$BDIR/libclaudecore.a" "$BDIR/libqwerty.a" $LINK $PYLINK -o "$OUT"
      echo "║ built: $OUT (dev build — headless-capable, OSMesa+GLFW)"
      echo "╚═══════════════════════════════════════════════════╝"
    else
      # SHIP build: windowed-only, no OSMesa dependency (see notes below).
      BDIR=$(build_engine "gcc" "linux-native" "-DCC_USE_GLFW -DCC_WINDOWED=1 -DCC_USE_AUDIO -I$ENGINE/third_party/openal-include")
      # AUDIO: link the SYSTEM OpenAL (libopenal.so) which ships PulseAudio/ALSA/
      # PipeWire backends. The bundled static libopenal.a only has the OSS backend,
      # which no modern Linux desktop uses → "no audio device". Prefer system; fall
      # back to bundled only if the system lib is absent.
      if ldconfig -p 2>/dev/null | grep -q "libopenal.so"; then
        AUDIO_LINK="-lopenal"
        echo "  (audio: linking system OpenAL — real backends)" >&2
      else
        AUDIO_LINK="$AUDIO_LINUX/lib/libopenal.a"
        echo "  (audio: WARNING — system OpenAL not found, using bundled OSS-only lib; install libopenal1 for sound)" >&2
      fi
      LINK="$GLFW_LINUX/lib/libglfw3.a $AUDIO_LINK"
      LINK="$LINK -lGL -lX11 -lXrandr -lXinerama -lXcursor -lXi -lm -lpthread -ldl -lrt -lstdc++"
      [ -f /usr/lib/x86_64-linux-gnu/libzstd.a ] && LINK="$LINK /usr/lib/x86_64-linux-gnu/libzstd.a" \
        || { [ -f /usr/lib/x86_64-linux-gnu/libzstd.so ] && LINK="$LINK -lzstd"; }
      gcc -O2 -std=gnu17 -DCC_USE_GLFW -DCC_USE_AUDIO $INC -I"$GLFW_LINUX/include" $SOURCES \
        "$BDIR/libclaudecore.a" "$BDIR/libqwerty.a" $LINK -o "$OUT"
      echo "║ built: $OUT (native Linux ELF)"
      echo "╚═══════════════════════════════════════════════════╝"
    fi
    ;;

  windows|win|win64)
    echo "╔═ cc build → windows (cross-compile) ══════════════╗"
    WINCC=x86_64-w64-mingw32-gcc
    # Need the C++ cross toolchain too: the bundled Windows OpenAL (OpenAL Soft)
    # is C++, so the final link pulls in static libstdc++ — which ships with
    # g++-mingw-w64, not the C-only gcc-mingw-w64. Ensure both are present.
    NEED_MINGW=0
    command -v $WINCC &>/dev/null || NEED_MINGW=1
    ls /usr/lib/gcc/x86_64-w64-mingw32/*/libstdc++.a &>/dev/null || NEED_MINGW=1
    if [ "$NEED_MINGW" = "1" ]; then
      echo "  installing mingw-w64 cross toolchain (gcc + g++)…"
      apt-get update -qq 2>/dev/null || true
      apt-get install -y -qq gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 2>/dev/null | tail -0 || true
    fi
    GLFW="$ENGINE/third_party/glfw-win64"
    [ -f "$GLFW/lib/libglfw3.a" ] || { echo "error: bundled Windows GLFW missing ($GLFW)"; exit 1; }
    BDIR=$(build_engine "$WINCC" "windows" "-DCC_USE_GLFW -DCC_USE_AUDIO -DAL_LIBTYPE_STATIC -I$GLFW/include -I$ENGINE/third_party/openal-include")
    AUDIO_WIN="$ENGINE/third_party/audio-win64"
    $WINCC -O2 -std=gnu17 -DCC_USE_GLFW -DCC_USE_AUDIO -DAL_LIBTYPE_STATIC $INC -I"$GLFW/include" $SOURCES \
      "$BDIR/libclaudecore.a" "$BDIR/libqwerty.a" "$GLFW/lib/libglfw3.a" \
      "$AUDIO_WIN/lib/libopenal.a" \
      -lopengl32 -lgdi32 -luser32 -lkernel32 -lshell32 -lwinmm -lws2_32 \
      -lole32 -loleaut32 -luuid -lksuser -lavrt -lmfplat -lmfuuid -lwmcodecdspuuid \
      -static -static-libgcc -static-libstdc++ -Wl,-Bstatic -lpthread -lstdc++ \
      -o "${OUT}.exe"
    echo "║ built: ${OUT}.exe (standalone Windows PE32+)"
    echo "║ deps: only standard Windows system DLLs (no mingw runtime)"
    echo "╚═══════════════════════════════════════════════════╝"
    ;;

  *) echo "error: unknown target '$TARGET' (use: linux | windows)"; exit 1;;
esac

# ── run ────────────────────────────────────────────────────────────────────
if [ "$CMD" = "run" ]; then
  [ "$TARGET" = "linux" ] && { echo "── running $OUT ──"; ./"$OUT"; } \
                          || echo "note: cannot run a $TARGET binary on this host"
fi

# ── bundle: package exe + assets/ + README into a shippable zip ─────────────
if [ "$CMD" = "bundle" ]; then
  BINNAME="$OUT"; [ "$TARGET" = "windows" ] && BINNAME="${OUT}.exe"
  [ -f "$BINNAME" ] || { echo "error: build produced no '$BINNAME'"; exit 1; }
  BASENAME="$(basename "$OUT")"
  STAGE="$(mktemp -d)/$BASENAME"
  mkdir -p "$STAGE/assets"
  cp "$BINNAME" "$STAGE/"
  # If the game source sits in a dir with an assets/ folder, ship it wholesale.
  if [ -d "$GAME" ] && [ -d "$GAME/assets" ]; then cp -r "$GAME/assets/." "$STAGE/assets/"; fi
  # AUTO-BUNDLE: copy ONLY the assets the game actually references via cc_asset("…")
  # from the in-development library (assets-dev/<type>/) into the shipped assets/.
  # This keeps shipped games lean — the dev library can be huge; only used files go.
  DEVLIB="$SKILL_DIR/assets-dev"
  if [ -d "$DEVLIB" ]; then
    # gather source files of this game
    SRCFILES=""
    if [ -d "$GAME" ]; then SRCFILES=$(find "$GAME" -name '*.c' -o -name '*.h'); else SRCFILES="$GAME"; fi
    # extract every cc_asset("NAME") literal
    USED=$(grep -hoE 'cc_asset\("[^"]+"\)' $SRCFILES 2>/dev/null | sed -E 's/cc_asset\("([^"]+)"\)/\1/' | sort -u)
    for name in $USED; do
      # find it anywhere under the dev library (any type subdir)
      found=$(find "$DEVLIB" -name "$name" -type f 2>/dev/null | head -1)
      if [ -n "$found" ]; then
        cp "$found" "$STAGE/assets/"
        echo "║   bundled asset: $name"
      else
        echo "║   WARNING: cc_asset(\"$name\") referenced but not found in assets-dev/"
      fi
    done
  fi
  # A .gitkeep so the empty assets/ folder survives zipping.
  [ -z "$(ls -A "$STAGE/assets" 2>/dev/null)" ] && touch "$STAGE/assets/.keep"
  cat > "$STAGE/README.txt" << EOF
$BASENAME — built with CC.

Run:
  $([ "$TARGET" = windows ] && echo "double-click $(basename "$BINNAME")" || echo "./$BASENAME")

Everything the game needs is in this folder. The engine (renderer, audio,
input, physics) is compiled into the executable — no install required. Any
game data files live in ./assets and are found relative to the executable.

Target: $TARGET
EOF
  OUTZIP="${BASENAME}-${TARGET}.zip"
  ( cd "$(dirname "$STAGE")" && zip -qr "$OLDPWD/$OUTZIP" "$BASENAME" )
  echo "║ bundled: $OUTZIP  ($(du -h "$OUTZIP" | cut -f1))"
  echo "║ contents: $BINNAME + assets/ + README.txt"
fi
